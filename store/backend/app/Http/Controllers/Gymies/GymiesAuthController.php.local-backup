<?php

declare(strict_types=1);

namespace App\Http\Controllers\Gymies;

use Illuminate\Http\JsonResponse;
use Illuminate\Http\Request;
use Illuminate\Support\Facades\DB;
use Illuminate\Support\Facades\Hash;
use Illuminate\Support\Facades\Log;
use Illuminate\Support\Facades\Schema;
use Illuminate\Support\Str;

/**
 * Gymies auth: login, register, me, etc.
 * Gebruikt gymies_users (of users) en personal_access_tokens.
 * Token-formaat: "id|plainToken" (Sanctum-compatibel) voor EnsureGymiesUserFromToken middleware.
 */
class GymiesAuthController
{
    private function usersTable(): string
    {
        return Schema::hasTable('gymies_users') ? 'gymies_users' : 'users';
    }

    private function passwordColumn(): string
    {
        $table = $this->usersTable();
        return Schema::hasColumn($table, 'password_hash') ? 'password_hash' : 'password';
    }

    private function userToResponse(object $row): array
    {
        $r = (array) $row;
        $role = $r['role'] ?? $r['user_role'] ?? null;
        $displayName = $r['display_name'] ?? $r['name'] ?? $r['email'] ?? '';
        $out = [
            'id' => $r['id'] ?? null,
            'email' => $r['email'] ?? '',
            'display_name' => $displayName,
            'name' => $displayName,
            'role' => $role,
            'user_role' => $role,
            'userType' => $role,
            'user_type' => $role,
            'accountType' => $role,
            'account_type' => $role,
            'type' => $role,
            'email_verified_at' => $r['email_verified_at'] ?? null,
        ];
        if (array_key_exists('gender', $r) && $r['gender'] !== null && $r['gender'] !== '') {
            $out['gender'] = $r['gender'];
        }

        // Optionele profielvelden meegeven als ze bestaan
        foreach (['phone', 'city', 'bio', 'emergency_contact_name', 'emergency_contact_phone', 'emergency_contact_email'] as $optCol) {
            if (array_key_exists($optCol, $r)) {
                $out[$optCol] = $r[$optCol];
            }
        }

        return $out;
    }

    public function login(Request $request): JsonResponse
    {
        $request->validate([
            'email' => 'required|string|email',
            'password' => 'required|string',
        ]);

        $table = $this->usersTable();
        $passCol = $this->passwordColumn();
        $user = DB::table($table)->where('email', $request->input('email'))->first();

        if (!$user || !Hash::check($request->input('password'), $user->{$passCol} ?? '')) {
            return response()->json(['message' => 'Ongeldige inloggegevens.'], 401);
        }

        $token = $this->createTokenForUser((int) $user->id);
        if ($token === null) {
            return response()->json(['message' => 'Kon geen sessie aanmaken.'], 500);
        }

        return response()->json([
            'token' => $token,
            'user' => $this->userToResponse($user),
        ]);
    }

    public function register(Request $request): JsonResponse
    {
        $validated = $request->validate([
            'email' => 'required|string|email',
            'password' => 'required|string|min:8',
            'role' => 'nullable|string|in:client,trainer,klant',
            'display_name' => 'nullable|string|max:255',
            'phone' => 'nullable|string|max:50',
            'gender' => 'nullable|string|in:male,female',
        ]);

        $table = $this->usersTable();
        $passCol = $this->passwordColumn();
        $exists = DB::table($table)->where('email', $validated['email'])->exists();
        if ($exists) {
            return response()->json(['message' => 'Dit e-mailadres is al geregistreerd.'], 422);
        }

        $insert = [
            'email' => $validated['email'],
            $passCol => Hash::make($validated['password']),
            'role' => $validated['role'] ?? 'client',
            'email_verified_at' => now(),
            'created_at' => now(),
            'updated_at' => now(),
        ];
        if (!empty($validated['display_name'])) {
            $insert['display_name'] = $validated['display_name'];
        }
        if (Schema::hasColumn($table, 'name') && empty($insert['name'] ?? null)) {
            $insert['name'] = $insert['display_name'] ?? $validated['email'];
        }
        if (!empty($validated['phone']) && Schema::hasColumn($table, 'phone')) {
            $insert['phone'] = $validated['phone'];
        }
        $roleNorm = strtolower((string) ($validated['role'] ?? 'client'));
        if (in_array($roleNorm, ['client', 'klant'], true)
            && !empty($validated['gender'])
            && Schema::hasColumn($table, 'gender')) {
            $insert['gender'] = $validated['gender'];
        }

        $userId = DB::table($table)->insertGetId($insert);
        $user = DB::table($table)->where('id', $userId)->first();
        $token = $this->createTokenForUser((int) $userId);

        if ($token === null) {
            return response()->json(['token' => null, 'user' => $this->userToResponse($user)]);
        }

        return response()->json([
            'token' => $token,
            'user' => $this->userToResponse($user),
        ]);
    }

    /**
     * Maak sessie-token in gymies_sessions (64 hex).
     * Alleen gymies_sessions – middleware accepteert geen id|plainToken meer.
     */
    private function createTokenForUser(int $userId): ?string
    {
        if (!Schema::hasTable('gymies_sessions') || !Schema::hasColumn('gymies_sessions', 'token')) {
            \Illuminate\Support\Facades\Log::error('[GymiesAuth] gymies_sessions tabel of token-kolom ontbreekt');
            return null;
        }

        $token = bin2hex(random_bytes(32)); // 64 hex karakters
        $row = [
            'user_id' => $userId,
            'token' => $token,
        ];
        if (Schema::hasColumn('gymies_sessions', 'created_at')) {
            $row['created_at'] = now();
        }
        if (Schema::hasColumn('gymies_sessions', 'updated_at')) {
            $row['updated_at'] = now();
        }
        if (Schema::hasColumn('gymies_sessions', 'last_activity')) {
            $row['last_activity'] = now();
        }
        if (Schema::hasColumn('gymies_sessions', 'ip_address')) {
            $row['ip_address'] = request()->ip();
        }
        if (Schema::hasColumn('gymies_sessions', 'user_agent')) {
            $row['user_agent'] = request()->userAgent();
        }
        if (Schema::hasColumn('gymies_sessions', 'expires_at')) {
            $row['expires_at'] = now()->addDays(30); // sessie 30 dagen geldig
        }

        try {
            DB::table('gymies_sessions')->insert($row);
            return $token;
        } catch (\Throwable $e) {
            Log::error('[GymiesAuth] gymies_sessions insert mislukt', [
                'user_id' => $userId,
                'error' => $e->getMessage(),
                'trace' => $e->getTraceAsString(),
            ]);
            return null;
        }
    }

    public function me(Request $request): JsonResponse
    {
        $user = $request->user();
        if (!$user || !($user->id ?? null)) {
            return response()->json(['message' => 'Niet ingelogd.'], 401);
        }
        $table = $this->usersTable();
        $row = DB::table($table)->where('id', (int) $user->id)->first();
        if (!$row) {
            return response()->json(['message' => 'Gebruiker niet gevonden.'], 404);
        }
        return response()->json(['data' => $this->userToResponse($row)]);
    }

    public function updateMe(Request $request): JsonResponse
    {
        $user = $request->user();
        if (!$user || !($user->id ?? null)) {
            return response()->json(['message' => 'Niet ingelogd.'], 401);
        }
        $body = $request->all();
        $table = $this->usersTable();
        $update = [];
        $columns = Schema::getColumnListing($table);
        foreach (['display_name', 'name', 'phone', 'city', 'bio', 'emergency_contact_name', 'emergency_contact_phone', 'emergency_contact_email'] as $col) {
            if (in_array($col, $columns, true) && array_key_exists($col, $body)) {
                $val = $body[$col];
                $update[$col] = is_string($val) ? (trim($val) ?: null) : null;
            }
        }
        if (!empty($update)) {
            $update['updated_at'] = now();
            DB::table($table)->where('id', (int) $user->id)->update($update);
        }
        $row = DB::table($table)->where('id', (int) $user->id)->first();
        return response()->json(['data' => $this->userToResponse($row)]);
    }

    public function changePassword(Request $request): JsonResponse
    {
        $user = $request->user();
        if (!$user || !($user->id ?? null)) {
            return response()->json(['message' => 'Niet ingelogd.'], 401);
        }
        $current = $request->input('current_password') ?? $request->input('old_password');
        $newPass = $request->input('password') ?? $request->input('new_password');
        $confirm = $request->input('password_confirmation') ?? $request->input('confirm_password');
        if (!$current || !$newPass || strlen($newPass) < 8 || $newPass !== $confirm) {
            return response()->json(['message' => 'Controleer je invoer. Wachtwoord moet minimaal 8 tekens zijn en bevestigd worden.'], 422);
        }
        $table = $this->usersTable();
        $passCol = $this->passwordColumn();
        $row = DB::table($table)->where('id', (int) $user->id)->first();
        if (!$row || !Hash::check($current, $row->{$passCol} ?? '')) {
            return response()->json(['message' => 'Huidig wachtwoord onjuist.'], 422);
        }
        DB::table($table)->where('id', (int) $user->id)->update([
            $passCol => Hash::make($newPass),
            'updated_at' => now(),
        ]);
        return response()->json(['message' => 'Wachtwoord bijgewerkt.']);
    }

    public function sessions(Request $request): JsonResponse
    {
        $user = $request->user();
        if (!$user || !($user->id ?? null)) {
            return response()->json(['message' => 'Niet ingelogd.'], 401);
        }
        return response()->json(['data' => []]);
    }

    public function logoutDevice(Request $request): JsonResponse
    {
        $user = $request->user();
        if (!$user || !($user->id ?? null)) {
            return response()->json(['message' => 'Niet ingelogd.'], 401);
        }
        $token = $this->rawTokenFromRequest($request);
        if ($token !== null && $token !== '') {
            if (Schema::hasTable('gymies_sessions')) {
                foreach (['token', 'access_token'] as $col) {
                    if (Schema::hasColumn('gymies_sessions', $col)) {
                        DB::table('gymies_sessions')->where($col, $token)->where('user_id', (int) $user->id)->delete();
                    }
                }
            }
            if (str_contains($token, '|')) {
                $plainToken = substr($token, strpos($token, '|') + 1);
                $hashed = hash('sha256', $plainToken);
                foreach (['personal_access_tokens', 'gymies_personal_access_tokens'] as $t) {
                    if (Schema::hasTable($t)) {
                        DB::table($t)->where('token', $hashed)->delete();
                    }
                }
            }
        }
        return response()->json(['message' => 'Uitgelogd.']);
    }

    public function logoutAllDevices(Request $request): JsonResponse
    {
        $user = $request->user();
        if (!$user || !($user->id ?? null)) {
            return response()->json(['message' => 'Niet ingelogd.'], 401);
        }
        if (Schema::hasTable('gymies_sessions')) {
            DB::table('gymies_sessions')->where('user_id', (int) $user->id)->delete();
        }
        foreach (['personal_access_tokens', 'gymies_personal_access_tokens'] as $t) {
            if (Schema::hasTable($t)) {
                DB::table($t)->where('tokenable_id', (int) $user->id)->delete();
            }
        }
        return response()->json(['message' => 'Overal uitgelogd.']);
    }

    private function rawTokenFromRequest(Request $request): ?string
    {
        $h = $request->header('Authorization') ?? $request->server('HTTP_AUTHORIZATION');
        if (is_string($h) && str_starts_with($h, 'Bearer ')) {
            return trim(substr($h, 7));
        }
        $h = $request->header('X-Authorization');
        if (is_string($h) && str_starts_with($h, 'Bearer ')) {
            return trim(substr($h, 7));
        }
        $h = $request->header('X-Gymies-Token');
        if (is_string($h) && $h !== '') return trim($h);
        if ($request->filled('access_token')) {
            return trim(rawurldecode((string) $request->input('access_token')));
        }
        return null;
    }

    public function resendVerificationCode(Request $request): JsonResponse
    {
        return response()->json(['message' => 'Verificatiecode verzonden.']);
    }

    public function verifyEmail(Request $request): JsonResponse
    {
        $request->validate(['email' => 'required|email', 'code' => 'required|string']);
        $table = $this->usersTable();
        DB::table($table)->where('email', $request->input('email'))->update([
            'email_verified_at' => now(),
            'updated_at' => now(),
        ]);
        $user = DB::table($table)->where('email', $request->input('email'))->first();
        $token = $user ? $this->createTokenForUser((int) $user->id) : null;
        return response()->json([
            'token' => $token,
            'user' => $user ? $this->userToResponse($user) : null,
        ]);
    }

    public function verifyEmailLink(Request $request): JsonResponse
    {
        return response()->json(['message' => 'E-mail geverifieerd.']);
    }

    public function forgotPassword(Request $request): JsonResponse
    {
        return response()->json(['message' => 'Als dit e-mailadres bestaat, ontvang je een link.']);
    }

    public function resetPassword(Request $request): JsonResponse
    {
        $request->validate([
            'email' => 'required|email',
            'token' => 'required|string',
            'password' => 'required|string|min:8|confirmed',
        ]);
        $table = $this->usersTable();
        $passCol = $this->passwordColumn();
        $updated = DB::table($table)->where('email', $request->input('email'))->update([
            $passCol => Hash::make($request->input('password')),
            'updated_at' => now(),
        ]);
        return response()->json(['message' => $updated ? 'Wachtwoord gereset.' : 'Ongeldige gegevens.']);
    }
}
