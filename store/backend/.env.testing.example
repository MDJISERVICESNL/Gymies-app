# ============================================================
# GYMIES — Mollie Test Configuratie
# ============================================================
# Kopieer dit bestand naar .env (of merge met je bestaande .env)
# om betalingen te testen met Mollie's sandbox.
#
# Stappen:
# 1. Log in op https://my.mollie.com → kies je Gymies organisatie
# 2. Ga naar Developers → API keys → kopieer je TEST key (begint met test_)
# 3. Vul onderstaande waarden in
# 4. Draai: php artisan config:cache
# ============================================================

# ── Mollie Test API Key ──────────────────────────────────────
# Ga naar: https://my.mollie.com → Developers → API keys
# Kopieer de key die begint met "test_"
MOLLIE_API_KEY=test_JOUW_MOLLIE_TEST_KEY_HIER

# ── Test Mode ────────────────────────────────────────────────
# Forceer testmode (nodig bij Mollie Connect met profileId)
MOLLIE_TESTMODE=true

# ── Mollie Profile ID ────────────────────────────────────────
# Te vinden in: Mollie Dashboard → Settings → Website profiles
# Formaat: pfl_XXXXXXXXXX (alleen nodig als platform zelf incasseert)
MOLLIE_PROFILE_ID=

# ── Mollie Connect (OAuth) ───────────────────────────────────
# Nodig voor trainer onboarding — vind je in Mollie Partner Dashboard
# https://my.mollie.com → Partner → App credentials
MOLLIE_CLIENT_ID=
MOLLIE_CLIENT_SECRET=

# ── Webhook URL ──────────────────────────────────────────────
# In test/lokaal: gebruik ngrok om je lokale server bereikbaar te maken.
#
#   ngrok http 8000
#
# Mollie stuurt webhooks naar: {APP_URL}/api/gymies/webhooks/mollie
# Zorg dat APP_URL je ngrok URL is, bijv:
APP_URL=https://JOUW-ID.ngrok-free.app

# ── Gymies Platform ──────────────────────────────────────────
GYMIES_HMAC_SECRET=test-hmac-secret-alleen-voor-lokaal
GYMIES_CRON_KEY=test-cron-key-lokaal
GYMIES_ADMIN_EMAIL=admin@gymies.nl
GYMIES_SERVICE_FEE_CENTS=49
GYMIES_APP_URL=https://gymiesapp.nl

# ── Webhook Secret (optioneel) ───────────────────────────────
# Als je Mollie webhook signature verificatie wilt testen
MOLLIE_WEBHOOK_SECRET=
