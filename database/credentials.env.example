# Kopieer naar de server als ~/.gymies_db.env en vul de echte waarden in.
# Op de server: chmod 600 ~/.gymies_db.env
#
# DB_NAME=mdjiservices
# DB_USER=mdjiservices_user
# DB_PASS=jouw_wachtwoord
# DB_HOST=127.0.0.1
# DB_PORT=3306

DB_NAME=your_database
DB_USER=your_user
DB_PASS=your_password
DB_HOST=127.0.0.1
DB_PORT=3306
