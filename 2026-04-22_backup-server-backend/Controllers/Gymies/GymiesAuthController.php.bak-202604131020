    private function createSession(int $userId, Request $request): string
    {
        $token = bin2hex(random_bytes(32));
        $expires = now()->addDays(self::SESSION_TTL_DAYS);
        $sessionPayload = [
            'user_id' => $userId,
            'token' => $token,
            'expires_at' => $expires,
